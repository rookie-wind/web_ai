# mcp_server 运行配置模板（复制为 .env 后填写真实值；.env 不得提交版本控制）
# 注意：.env 仅由 start.bat 解析注入，直接 python server.py 启动的进程不加载它。

# 监听地址与端口。默认 0.0.0.0（全部网卡，便于内网同事直连）；
# 公网形态（MCP_PUBLIC_MODE=1）下 MUST 改为 127.0.0.1，仅由反向代理转发
MCP_HOST=0.0.0.0
MCP_PORT=8765

# 管理员 Bearer Token，用于 localhost 系统级访问（留空则自动生成）
MCP_AUTH_TOKEN=

# webchat 专属接入凭据签发/撤销（mint/revoke）端点的共享密钥（空则 mint 一律 401）
WEBCHAT_MINT_SECRET=

# 公网暴露门控开关：0=既有内网行为（默认）；1=展示类端点仅本机/allowlist 放行，
# URL 凭据端点（模板票据下载、/api/logs 查询串 token）非本机来源补充鉴权
MCP_PUBLIC_MODE=0

# 公网模式下展示类端点的额外放行来源（逗号分隔 IP，一般填运维出口 IP）
MCP_PUBLIC_ALLOWLIST=

# 可信反向代理 IP 清单（逗号分隔）。仅当直连来源命中该清单时才采信
# X-Forwarded-For 最左值；未配置时一律使用直连地址，伪造转发头无效
MCP_TRUSTED_PROXY=
