  "nodes": [
    {
      "id": "file:mcp_server/archiving/converter.py",
      "type": "file",
      "name": "converter.py",
      "filePath": "mcp_server/archiving/converter.py",
      "summary": "实现 175 参数组件的通讯地址转换规则（去条码第 1、2、7 位中间补三个 0 得 12 位地址）并提供地址格式校验，供基本档案与网关参数项 20100024 共用。",
      "tags": [
        "conversion",
        "validation",
        "utility"
      ],
      "complexity": "moderate",
      "languageNotes": "是否套用转换由设备 profile 决定，本模块不强制；XLBA 电表叶子的 identifier 通常直接等于 deviceAddress。"
    },
    {
      "id": "file:mcp_server/archiving/profiles/__init__.py",
      "type": "file",
      "name": "__init__.py",
      "filePath": "mcp_server/archiving/profiles/__init__.py",
      "summary": "设备类型 profile 插件包的入口，说明基类、注册表与各 deviceTypeId profile 的职责划分及新增类型的扩展方式。",
      "tags": [
        "entry-point",
        "barrel",
        "package-init"
      ],
      "complexity": "simple"
    },
    {
      "id": "file:mcp_server/archiving/profiles/base.py",
      "type": "file",
      "name": "base.py",
      "filePath": "mcp_server/archiving/profiles/base.py",
      "summary": "定义 profile 基类、ProfileResult 与 deviceTypeId/itemId 常量，并承载端口驱动的多态 authParam 组装与下发侧归一逻辑，引擎只依赖本基类接口。",
      "tags": [
        "core-engine",
        "abstraction",
        "data-model",
        "protocol-encoding"
      ],
      "complexity": "complex",
      "languageNotes": "authParam 是多态落点：IP 型端口承载五段逗号串，RS485 串口端口承载电表密码；下发侧另有 12 位十六进制形态，两者分属不同落点。"
    },
