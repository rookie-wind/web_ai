  "nodes": [
    {
      "id": "file:mcp_server/archiving/log_sanitizer.py",
      "type": "file",
      "name": "log_sanitizer.py",
      "filePath": "mcp_server/archiving/log_sanitizer.py",
      "summary": "对日志与报告输出做敏感信息脱敏，覆盖 Bearer Token、密码类键值、票据查询参数、Authorization 头部与原始请求体。",
      "tags": [
        "security",
        "sanitization",
        "logging",
        "utility"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:mcp_server/archiving/snapshot_store.py",
      "type": "file",
      "name": "snapshot_store.py",
      "filePath": "mcp_server/archiving/snapshot_store.py",
      "summary": "非敏感模板快照的服务端私有存储与权威核对，管住归属、有效期与内容摘要，并附带 owner 隔离的分块上传会话管理。",
      "tags": [
        "persistence",
        "snapshot",
        "security",
        "validation"
      ],
      "complexity": "complex",
      "languageNotes": "所有写入均为临时文件 + os.replace 原子落盘；归属身份由已验证 MCP Token 的不可逆摘要派生，不使用 IP 或用户传入字段。"
    },
    {
      "id": "file:mcp_server/archiving/stage_orchestrator.py",
      "type": "file",
      "name": "stage_orchestrator.py",
      "filePath": "mcp_server/archiving/stage_orchestrator.py",
      "summary": "按建档→参数保存→网关时钟→批量下发→召测的依赖顺序编排并汇总阶段状态，前置阶段未成功则阻止后续执行。",
      "tags": [
        "orchestration",
        "state-machine",
        "validation"
      ],
      "complexity": "complex",
      "languageNotes": "单独诊断模式不计入全链路汇总，也不补做未授权的前序写入。"
    },
    {
      "id": "file:mcp_server/archiving/task_report_store.py",
      "type": "file",
      "name": "task_report_store.py",
      "filePath": "mcp_server/archiving/task_report_store.py",
      "summary": "将脱敏计划、动作意图与结果、补偿清单和阶段状态持久化到私有报告目录，支持进程中断后查询与任务过期后由所属身份回看。",
      "tags": [
        "persistence",
        "reporting",
        "security",
        "audit"
      ],
      "complexity": "complex"
    },
