    {
      "id": "file:mcp_server/archiving/compensation.py",
      "type": "file",
      "name": "compensation.py",
      "filePath": "mcp_server/archiving/compensation.py",
      "summary": "记录本次新建设备形成补偿清单，并在用户明确确认后按叶子到父节点顺序调用 deleteDevice 回滚，绝不触碰清单外的既有设备。",
      "tags": [
        "compensation",
        "rollback",
        "safety",
        "service"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:mcp_server/archiving/engine.py",
      "type": "file",
      "name": "engine.py",
      "filePath": "mcp_server/archiving/engine.py",
      "summary": "自动建档引擎的纯逻辑核心：拓扑排序、以设备名称为键的幂等匹配与 dry-run 计划生成，自身不做任何 I/O。",
      "tags": [
        "core-engine",
        "planning",
        "idempotency",
        "topological-sort"
      ],
      "complexity": "complex",
      "languageNotes": "引擎与 I/O 彻底解耦，写入与联通交由 Skill 编排原子工具执行，本模块只回答「计划什么、为什么」。"
    },
    {
      "id": "file:mcp_server/archiving/excel_reader.py",
      "type": "file",
      "name": "excel_reader.py",
      "filePath": "mcp_server/archiving/excel_reader.py",
      "summary": "把面向工程人员的 v15-engineer 工作簿解析为 ArchiveTemplate，只做提取与结构性校验，字段级业务校验交由 profile 与引擎。",
      "tags": [
        "parser",
        "excel",
        "validation",
        "serialization"
      ],
      "complexity": "complex",
      "languageNotes": "类型保真语义：整数不转浮点、0/False 不误判为空、文本条码保留前导零、密码原文保留但序列化时脱敏。"
    },
    {
      "id": "file:mcp_server/archiving/field_contract.py",
      "type": "file",
      "name": "field_contract.py",
      "filePath": "mcp_server/archiving/field_contract.py",
      "summary": "版本化字段契约的单一事实源，以 TypeSheetSpec 声明各设备类型的表结构、工程列、派生字段与接口能力，并按证据状态对码值出处分级。",
      "tags": [
        "contract",
        "single-source-of-truth",
        "data-model",
        "validation"
      ],
      "complexity": "complex",
      "languageNotes": "未证实的落点一律标 UNVERIFIED 并禁止进入可执行模板与下发，构成 G1 现场核验门槛。"
    },
