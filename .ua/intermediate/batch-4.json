{
  "nodes": [
    {
      "id": "file:mcp_server/api_client.py",
      "type": "file",
      "name": "api_client.py",
      "filePath": "mcp_server/api_client.py",
      "summary": "封装规约管理后端的 HTTP 调用，用自定义 Token 请求头鉴权并把网络、HTTP、业务与认证异常统一归一化为带 error/code/message 的返回结构。",
      "tags": [
        "api-client",
        "http",
        "error-handling",
        "normalization"
      ],
      "complexity": "complex",
      "languageNotes": "成功判据为 code === 20000，40100 表示登录失效，40000 为业务异常；成功时还用 empty 标志区分“查询为空”与“查询失败”。"
    },
    {
      "id": "file:mcp_server/archiving/reference_config.py",
      "type": "file",
      "name": "reference_config.py",
      "filePath": "mcp_server/archiving/reference_config.py",
      "summary": "阶段一模板生成所用的固定参考环境配置读取器，只消费管理员显式提供的来源，不预置任何地址账号也不从上传工作簿推导。",
      "tags": [
        "configuration",
        "security",
        "reference-environment"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:mcp_server/archiving/reference_provider.py",
      "type": "file",
      "name": "reference_provider.py",
      "filePath": "mcp_server/archiving/reference_provider.py",
      "summary": "参考环境字典读取提供者，用互相隔离的云端系统 Token 专用链与独立边缘签名链取字典，认证失败绝不回退用户会话。",
      "tags": [
        "reference-environment",
        "authentication",
        "data-provider",
        "isolation"
      ],
      "complexity": "complex"
    },
    {
      "id": "file:mcp_server/edge_client.py",
      "type": "file",
      "name": "edge_client.py",
      "filePath": "mcp_server/edge_client.py",
      "summary": "边缘建档后端客户端，实现 RSA 登录、五头签名与 rtnCode 归一化，并把联通类接口结果归为三态，与云端客户端完全独立。",
      "tags": [
        "api-client",
        "authentication",
        "signature",
        "normalization"
      ],
      "complexity": "complex",
      "languageNotes": "每次业务调用携带 appCode/token/tokenEncrypt/dateTime/userId 五个签名头，其中 tokenEncrypt = md5(token + loginStr + dateTime)。"
    },
    {
      "id": "file:mcp_server/edge_proxy_config.py",
      "type": "file",
      "name": "edge_proxy_config.py",
      "filePath": "mcp_server/edge_proxy_config.py",
      "summary": "门户代理配置加载器，由服务端直接读取 proxy_config.json 使任意启动方式生效，配置文件优先于环境变量回退。",
      "tags": [
        "configuration",
        "proxy",
        "utility"
      ],
      "complexity": "simple"
    },
    {
      "id": "file:mcp_server/permissions.py",
      "type": "file",
      "name": "permissions.py",
      "filePath": "mcp_server/permissions.py",
      "summary": "云端平台写权限判定模块，用本地超级账号配置确认写权限并缓存业务 Token 到账号标识的映射，与 MCP 接入 Token 完全解耦。",
      "tags": [
        "authorization",
        "security",
        "caching",
        "persistence"
      ],
      "complexity": "complex"
    },
