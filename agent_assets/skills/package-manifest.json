    "skills/xlpa/SKILL.md",
    "skills/xlpa/agents/openai.yaml",
    "skills/xlpa/tools/mcp_client.py",
    "skills/xlpa/manifest.json",
    "skills/xlpa-device-archiving/SKILL.md",
    "skills/xlpa-device-archiving/agents/openai.yaml",
    "skills/xlpa-device-archiving/manifest.json",
    "skills/xlpa-device-archiving/references/excel-template-schema.md",
    "skills/xlpa-device-archiving/references/platform-dict-template-generation.md",
    "skills/xlpa-device-archiving/references/gateway-button-endpoints.md",
    "skills/xlpa-device-archiving/references/device-onboarding-playbook.md",
    "skills/xlpa-device-archiving/references/direct-edge-operation.md",
    "skills/modbus-conversion/SKILL.md",
    "skills/modbus-conversion/agents/openai.yaml",
    "skills/modbus-conversion/manifest.json",
    "skills/mqtt-conversion/SKILL.md",
    "skills/mqtt-conversion/agents/openai.yaml",
    "skills/mqtt-conversion/manifest.json",
    "skills/http-conversion/SKILL.md",
    "skills/http-conversion/agents/openai.yaml",
    "skills/http-conversion/manifest.json",
    "skills/protocol-conversion/SKILL.md",
    "skills/protocol-conversion/agents/openai.yaml",
    "skills/protocol-conversion/manifest.json",
    "skills/test-validation/SKILL.md",
    "skills/test-validation/agents/openai.yaml",
    "skills/test-validation/manifest.json",
    "skills/pack-distribution/SKILL.md",
    "skills/pack-distribution/agents/openai.yaml",
    "skills/pack-distribution/manifest.json",
    "skills/modbus-cq-adapt/SKILL.md",
    "skills/modbus-cq-adapt/agents/openai.yaml",
    "skills/modbus-cq-adapt/manifest.json"
