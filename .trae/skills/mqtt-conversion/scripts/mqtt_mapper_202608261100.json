              "type": "double"
            },
            {
              "target": "Ia",
              "source": "currentA",
              "type": "double"
            },
            {
              "target": "Ib",
              "source": "currentB",
              "type": "double"
            },
            {
              "target": "Ic",
              "source": "currentC",
              "type": "double"
            },
            {
              "target": "P",
              "source": "P",
              "type": "double"
            },
            {
              "target": "Q",
              "source": "Q",
              "type": "double"
            },
            {
              "target": "dataTime",
              "source": "timeStamp",
              "type": "string",
