{
  "base_url": "http://cloud.linktheall.cn",
  "timeout": 30000,
  "domain": "",
  "token": {
    "login_path": "/meter2/api/user/login",
    "login_method": "POST",
    "content_type": "application/json",
    "token_path": "token",
    "token_header": "token",
    "expires_in": 604800,
    "login_params": {
      "username": "${USERNAME}",
      "password": "${PASSWORD}"
    }
  },
  "apis": [
    {
      "name": "get_records",
      "method": "POST",
      "path": "/meter2/api/record/history",
      "use_token": true,
      "content_type": "application/json",
      "interval": 8,
      "interval_type": "hour",
      "next_api": "",
      "body_params": [
        {
          "name": "startTime",
          "source_type": "context",
          "source": "startTime",
          "type": "string"
        },
        {
          "name": "endTime",
          "source_type": "context",
          "source": "endTime",
          "type": "string"
        }
      ],
      "data_mappings": [
        {
          "target": "taskId",
          "source_type": "constant",
          "constant": 8220,
          "type": "int"
        },
        {
          "target": "udSign",
          "source_type": "constant",
          "constant": 1,
          "type": "int"
        },
        {
          "target": "cmdType",
          "source_type": "constant",
          "constant": 1,
          "type": "int"
        },
        {
          "target": "priority",
          "source_type": "constant",
          "constant": 0,
          "type": "int"
        },
        {
          "target": "commObj.commAddr",
          "source_type": "path",
          "source": "data[0].deviceId",
          "type": "string"
        },
        {
          "target": "businessObjList[0].dataObj.timeType",
          "source_type": "constant",
          "constant": 4,
          "type": "int"
        },
        {
          "target": "businessObjList[0].dataObj.dataItemList[0].itemBody.@",
          "source_type": "array_foreach",
          "source": "data[*]",
          "type": "object",
          "item_type": "object",
          "sub_mappings": [
            {
              "target": "roadNo",
              "source_type": "constant",
              "constant": 1,
              "type": "int"
            },
            {
              "target": "dataTime",
              "source_type": "path",
              "source": "createTime",
              "type": "string"
            },
            {
              "target": "item.@",
              "source_type": "array_foreach",
              "source": ".",
              "type": "object",
              "item_type": "key_value",
              "sub_mappings": [
                {
                  "target": "tolCumulativeFlow",
                  "source_type": "path",
                  "source": "value",
                  "type": "double"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
